# Seyyahname AI Coach: copy to app/.env (or app/.env.local) for development, or set these as
# environment variables in the hosting panel. Never commit or share the real values.

# Required: the PIN / password the lock screen asks for. Use 8+ characters.
APP_SECRET_PIN=change-me

# Required in production: a long random string that signs the session JWT (HS256).
# Rotating it (or the PIN) signs every device out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SESSION_SECRET=

# Session length in days (default 7, at most 90).
SESSION_DAYS=7

# Optional: Google Gemini API key (https://aistudio.google.com/apikey). Enables the Coach chat and
# AI feedback; without it the app uses its offline feedback engine.
GEMINI_API_KEY=
# "gemini-flash-latest" always points to Google's current Flash model.
GEMINI_MODEL=gemini-flash-latest

# Where profile.json, vocabulary.md, error_ledger.md and sessions/ live. Relative paths start at the
# app folder (also for the standalone server); an absolute path outside the app is safest.
DATA_DIR=data

# Public address for canonical, OpenGraph and Twitter links. Read at build time;
# production builds default to https://app.seyyahname.com.
SITE_URL=https://app.seyyahname.com

# Port for `npm start` (hosting panels usually set this themselves).
PORT=3000
